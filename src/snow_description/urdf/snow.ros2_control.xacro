<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="Arm" type="system">
  
    <hardware>
        <plugin>arm_hardware_interface/ArmHardwareInterface</plugin>
        <param name="command_time_ms">100</param>
        <param name="startup_time_ms">1500</param>
    </hardware>

    <!--
      Initial values are used only by mock_components; they are ignored by the
      real plugin, which seeds positions from the first /arm/feedback message.
      They are kept here as documentation of the arm's home pose.
    -->
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.0471</param>
      </state_interface>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.7453</param>
      </state_interface>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
    </joint>

    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0</param>
      </state_interface>
    </joint>

    <joint name="r_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.117</param>
      </state_interface>
    </joint>
  </ros2_control>
</robot>